# Copy to .env.development / .env.test and fill in. `src/config.ts` (convict) reads
# `.env.${NODE_ENV}` from the process cwd, so run every command from `server/`.
# Every var defaults to '' — a missing one fails when the code path is first hit,
# not at startup. Only the DB/Liquibase block is needed to run the test suite.

# --- Postgres (required for `yarn test:integration`, `yarn dev`) -------------
# Point this at a throwaway database: the integration teardown runs Liquibase
# `drop-all` against it. Create one with:
#   psql -h 127.0.0.1 -U postgres -c "CREATE DATABASE icruiting_test OWNER $USER;"
DATABASE_URL=postgres://<user>@127.0.0.1:5432/icruiting_test

# Liquibase gets a JDBC URL — `migrate.ts` prefixes it with `jdbc:`, so leave that off
# here. It is a separate connection string from DATABASE_URL and takes no credentials
# inline; username/password go in their own vars. Password may be empty for local
# `trust` auth.
LIQUIBASE_DB_URL=postgresql://127.0.0.1:5432/icruiting_test
LIQUIBASE_DB_USERNAME=<user>
LIQUIBASE_DB_PASSWORD=
# Relative to the cwd (`server/`).
LIQUIBASE_CHANGELOG_FILE=src/infrastructure/db/migrations/changelog.xml
# off | severe | warning | info | debug — `off` keeps the test output readable.
LIQUIBASE_LOG_LEVEL=off

# --- API ---------------------------------------------------------------------
PORT=5000
API_BASE_URL=http://localhost:5000

# --- Cognito (mocked in integration tests; needed by `yarn dev` for real auth) --
AWS_USER_POOL_ID=
AWS_CLIENT_ID=
AWS_REGION=

# --- S3 uploads (mocked in integration tests) ---------------------------------
S3_BUCKET=
S3_REGION=

# --- Outbound mail, SMTP via smtp.zoho.eu (not mocked; unset = applicant
#     confirmation mails throw and get swallowed by a .catch) --------------------
EMAIL_ADRESS=
EMAIL_PASSWORD=

# --- Stripe (mocked in integration tests; billing is slated for removal) -------
STRIPE_SECRET_KEY=
FREE_STRIPE_PRODUCT_ID=

# --- ntfy error/signup alerts (only fire when NODE_ENV=production) ------------
# NTFY_URL falls back to https://ntfy.sh when empty.
NTFY_URL=
NTFY_TOPIC=
